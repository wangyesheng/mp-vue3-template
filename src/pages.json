{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^nut-(.*)?-(.*)": "nutui-uniapp/components/$1$2/$1$2.vue",
      "^nut-(.*)": "nutui-uniapp/components/$1/$1.vue",
      "^(?!nut-)([A-Z][a-zA-Z]*)$": "@/components/$1/index.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/order/bind",
      "style": {
        "navigationBarTitleText": "订单绑定"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/warranty/index",
      "style": {
        "navigationBarTitleText": "质保信息",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/me/personal",
      "style": {
        "navigationBarTitleText": "编辑个人信息"
      }
    },
    {
      "path": "pages/me/setting",
      "style": {
        "navigationBarTitleText": "设置"
      }
    },
    {
      "path": "pages/me/richtext",
      "style": {
        "navigationBarTitleText": "关于我们"
      }
    },
    {
      "path": "pages/web-view/index",
      "style": {
        "navigationBarTitleText": ""
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "首页",
    "navigationBarBackgroundColor": "#f5f6fa",
    "backgroundColor": "#f5f6fa"
  }
}
