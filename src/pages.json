{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^nut-(.*)?-(.*)": "nutui-uniapp/components/$1$2/$1$2.vue",
      "^nut-(.*)": "nutui-uniapp/components/$1/$1.vue",
      "^(?!nut-)([A-Z][a-zA-Z]*)$": "@/components/$1/index.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/order/bind",
      "style": {
        "navigationBarTitleText": "订单绑定"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "我的订单"
      }
    },
    {
      "path": "pages/mall/index",
      "style": {
        "navigationBarTitleText": "积分商城"
      }
    },
    {
      "path": "pages/mall/record",
      "style": {
        "navigationBarTitleText": "兑换记录"
      }
    },
    {
      "path": "pages/after-sale/index",
      "style": {
        "navigationBarTitleText": "申请售后"
      }
    },
    {
      "path": "pages/after-sale/timeline",
      "style": {
        "navigationBarTitleText": "售后进度"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/warranty/index",
      "style": {
        "navigationBarTitleText": "质保信息",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/web-view/index",
      "style": {
        "navigationBarTitleText": ""
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "首页",
    "navigationBarBackgroundColor": "#f5f6fa",
    "backgroundColor": "#f5f6fa"
  }
}
